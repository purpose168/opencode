{
  "proseWrap": "preserve",
  "semi": false,
  "alignComments": true,
  "commentLineOffset": 2,
  "trailingComma": "es5",

  "tabWidth": 4,
  "useTabs": false,
  "indentSize": 4,

  "printWidth": 140,
  "lineLength": 140,
  "endOfLine": "lf",

  "singleQuote": false,

  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",

  "vueIndentScriptAndStyle": true,
  "htmlWhitespaceSensitivity": "css"
}
